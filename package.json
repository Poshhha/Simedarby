    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "prettier": "^3.6.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
